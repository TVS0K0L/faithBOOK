{
  "expo": {
    "name": "faithBOOK",
    "slug": "faithbook",
    "scheme": "faithbook",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF3FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.faithbook",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos to share with your church.",
        "NSCameraUsageDescription": "Take a photo of the Cross you wrote, or of a moment to share."
      }
    },
    "android": {
      "package": "app.faithbook",
      "adaptiveIcon": {
        "backgroundColor": "#EEF3FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to share with your church."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}